<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bjtufood.dish.mapper.DishMapper">

    <!--
    ============================================================
    菜品模块 - 自定义 SQL 映射

    基础 CRUD 由 MyBatis-Plus 自动生成，无需在此编写。
    以下放置复杂查询（如多表关联、动态排序等）。

    命名规则：
    - select___：查询操作
    - count___：计数操作
    - update___：更新操作
    ============================================================
    -->

    <!-- DishVO / DishDetailVO 结果映射 -->
    <resultMap id="dishVOMap" type="com.bjtufood.dish.dto.DishVO">
        <id property="id" column="id"/>
        <result property="stallId" column="stall_id"/>
        <result property="canteenId" column="canteen_id"/>
    </resultMap>

    <resultMap id="dishDetailMap" type="com.bjtufood.dish.dto.DishDetailVO"
               extends="dishVOMap"/>

    <!-- 联表查询基础 SQL 片段 -->
    <sql id="joinDishSql">
        SELECT
            d.id,
            d.name,
            d.price,
            d.images  AS images_json,
            d.tags,
            d.description,
            d.avg_rating,
            d.rating_count,
            d.favorite_count AS collect_count,
            d.view_count,
            d.status,
            d.created_at,
            s.id   AS stall_id,
            s.name AS stall_name,
            c.id   AS canteen_id,
            c.name AS canteen_name
        FROM dish d
                 JOIN stall s ON d.stall_id = s.id
                 JOIN canteen c ON s.canteen_id = c.id
    </sql>

    <!-- 分页查询菜品 -->
    <select id="selectDishPage" resultMap="dishVOMap">
        <include refid="joinDishSql"/>
        WHERE d.status = 'on'
          AND s.status = 'open'
          AND c.status = 'open'
        <if test="req.keyword != null and req.keyword != ''">
            AND (d.name LIKE CONCAT('%', #{req.keyword}, '%')
            OR s.name LIKE CONCAT('%', #{req.keyword}, '%')
            OR c.name LIKE CONCAT('%', #{req.keyword}, '%')
            OR d.tags LIKE CONCAT('%', #{req.keyword}, '%'))
        </if>
        <if test="req.canteenId != null">
            AND c.id = #{req.canteenId}
        </if>
        <if test="req.stallId != null">
            AND s.id = #{req.stallId}
        </if>
        <if test="req.tag != null and req.tag != ''">
            AND d.tags LIKE CONCAT('%', #{req.tag}, '%')
        </if>
        <if test="req.minPrice != null">
            AND d.price &gt;= #{req.minPrice}
        </if>
        <if test="req.maxPrice != null">
            AND d.price &lt;= #{req.maxPrice}
        </if>
        <choose>
            <when test="req.sortBy == 'rating'">
                ORDER BY d.avg_rating
                <choose>
                    <when test="req.sortOrder == 'asc'">ASC</when>
                    <otherwise>DESC</otherwise>
                </choose>
            </when>
            <when test="req.sortBy == 'price'">
                ORDER BY d.price
                <choose>
                    <when test="req.sortOrder == 'desc'">DESC</when>
                    <otherwise>ASC</otherwise>
                </choose>
            </when>
            <when test="req.sortBy == 'collects'">
                ORDER BY d.favorite_count
                <choose>
                    <when test="req.sortOrder == 'asc'">ASC</when>
                    <otherwise>DESC</otherwise>
                </choose>
                , d.avg_rating DESC
            </when>
            <when test="req.sortBy == 'created_at'">
                ORDER BY d.created_at
                <choose>
                    <when test="req.sortOrder == 'asc'">ASC</when>
                    <otherwise>DESC</otherwise>
                </choose>
            </when>
            <otherwise>
                ORDER BY d.favorite_count DESC, d.avg_rating DESC
            </otherwise>
        </choose>
    </select>

    <!-- 热门菜品 TOP10 -->
    <select id="selectHotDishes" resultMap="dishVOMap">
        <include refid="joinDishSql"/>
        WHERE d.status = 'on'
          AND s.status = 'open'
          AND c.status = 'open'
        ORDER BY d.favorite_count DESC, d.avg_rating DESC
        LIMIT 10
    </select>

    <!-- 菜品详情 -->
    <select id="selectDishDetail" resultMap="dishDetailMap">
        <include refid="joinDishSql"/>
        WHERE d.id = #{id}
          AND d.status = 'on'
          AND s.status = 'open'
          AND c.status = 'open'
        LIMIT 1
    </select>

    <!-- DishAdminVO 结果映射（后台全部菜品） -->
    <resultMap id="dishAdminVOMap" type="com.bjtufood.dish.dto.DishAdminVO">
        <id property="id" column="id"/>
        <result property="stallId" column="stall_id"/>
    </resultMap>

    <!-- 后台全部菜品列表（含已下架，联表档口/食堂名称） -->
    <select id="selectAllForAdmin" resultMap="dishAdminVOMap">
        <include refid="joinDishSql"/>
        ORDER BY d.updated_at DESC
    </select>

    <!-- 评分分布 -->
    <select id="selectRatingDistribution" resultType="com.bjtufood.dish.dto.RatingDistributionVO">
        SELECT rating AS star, COUNT(*) AS count
        FROM review
        WHERE dish_id = #{dishId}
          AND is_hidden = 0
        GROUP BY rating
    </select>

</mapper>
