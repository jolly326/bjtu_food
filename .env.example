# Copy this file to server/.env or .env, then fill in real values.
# Do not commit real .env files.

# QQ Mail example:
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-qq-mail@qq.com
MAIL_PASSWORD=your-smtp-authorization-code

# Public base URL used to build image URLs returned to frontend.
# Local browser test:
APP_PUBLIC_BASE_URL=http://localhost:8080/api

# For mobile mini-program testing, use your LAN/server IP instead:
# APP_PUBLIC_BASE_URL=http://192.168.1.23:8080/api

# Uploaded image storage path.
UPLOAD_PATH=./uploads/images
UPLOAD_URL_PREFIX=/images
