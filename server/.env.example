# ===== 运行模式 =====
# dev / development / local ⇒ 暴露 /docs 与 /openapi.json（本地联调与契约刷新用）
# prod / production / 留空 ⇒ 不暴露（云端默认即生产，无需设置）
APP_ENV=dev

# ===== 数据库 =====
# 两组等价变量名，填任一套即可（server/.env 里两套都有）
# SQLAlchemy 连接串（MySQL 5.7 + PyMySQL）
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@YOUR_HOST:27926/bjtu_food?charset=utf8mb4
DATABASE_USER=root
DATABASE_PASSWORD=YOUR_PASSWORD

# SPRING_DATASOURCE_URL=YOUR_HOST:27926
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=YOUR_PASSWORD

# ===== 本地开发覆盖（可选）=====
# 在 server/ 下新建 .env.local（已 gitignore），只写差异项；加载顺序 .env → .env.local（后者覆盖前者）。
# 进程环境变量优先级最高：云端控制台注入的 DATABASE_URL / APP_ENV 会覆盖任何文件值。
# APP_ENV=dev
# DATABASE_URL=mysql+pymysql://root:LOCAL_PASSWORD@127.0.0.1:3306/bjtu_food?charset=utf8mb4

# ===== JWT =====
# 学生端签名密钥（>= 32 字节随机串）
JWT_SECRET=replace-with-a-long-random-string
# 运营端签名密钥 —— 🔴 必须与学生端不同，否则学生 token 可冒充运营端
ADMIN_JWT_SECRET=replace-with-another-long-random-string
# 学生端 / 运营端 JWT 有效期（秒，默认 604800 = 7 天）
JWT_TTL_SECONDS=604800

# ===== 微信小程序 =====
# 🔴 云端必须设置：云端容器不读取 .env（Dockerfile 只 COPY app），
#    需在云托管控制台注入；与小程序 appid/secret 不一致时 /auth/wechat-login 返回 400（code 无效）
WECHAT_APPID=
WECHAT_SECRET=

# ===== 跨域（运营端在浏览器直连本服务时）=====
# `*` 或逗号分隔的 Origin 白名单（生产建议收敛为具体域名；
# 生产取 `*` 时启动会打告警 —— 任意站点均可跨域调用本服务）
CORS_ALLOW_ORIGINS=*

# ===== 腾讯云 COS（档口海报 / 菜品图转存）=====
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
# 图片访问域名（如 https://xxx-1408890131.cos.ap-shanghai.myqcloud.com）
# 🔴 所有环境必填：图片出参恒绝对 URL，缺失时服务拒绝启动（见 app/core/config.py）
COS_DOMAIN=

# 说明：真值只写 server/.env（已 gitignore）；本文件仅列占位符，勿填真实凭据。
