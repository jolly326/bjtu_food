# ===== 运行档位（决定读哪份文件）=====
# APP_PROFILE 缺省 = development ⇒ 读 server/.env.development（+ 可选的 .env.local，后者覆盖前者）
# APP_PROFILE=production        ⇒ 读 server/.env.production
# 生产容器不含任何 .env*（.dockerignore 已排除），凭据一律由云托管控制台注入 ——
# 进程环境变量优先级最高，会覆盖文件里的同名键。
# APP_PROFILE=development

# ===== 运行模式 =====
# dev / development / local ⇒ 暴露 /docs 与 /openapi.json（本地联调与契约刷新用）
# prod / production / 留空 ⇒ 不暴露（云端默认即生产，无需设置）
APP_ENV=dev

# ===== 数据库 =====
# 两组等价变量名，填任一套即可
# SQLAlchemy 连接串（MySQL 5.7 + PyMySQL）
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@YOUR_HOST:3306/bjtu_food?charset=utf8mb4
DATABASE_USER=root
DATABASE_PASSWORD=YOUR_PASSWORD

# SPRING_DATASOURCE_URL=YOUR_HOST:3306
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=YOUR_PASSWORD

# ===== 个人本地覆盖（可选）=====
# server/.env.local（已 gitignore）只在 development 档位加载，写个人差异项即可；
# 切换 production 档位时它不参与，不会把生产连接串覆盖成本地。

# ===== JWT =====
# 学生端签名密钥（>= 32 字节随机串）
JWT_SECRET=replace-with-a-long-random-string
# 运营端签名密钥 —— 🔴 必须与学生端不同，否则学生 token 可冒充运营端
ADMIN_JWT_SECRET=replace-with-another-long-random-string
# 学生端 / 运营端 JWT 有效期（秒，默认 604800 = 7 天）
JWT_TTL_SECONDS=604800

# ===== 微信小程序 =====
# 🔴 云端必须在控制台注入；与小程序 appid/secret 不一致时 /auth/wechat-login 返回 400（code 无效）
WECHAT_APPID=
WECHAT_SECRET=

# ===== 跨域（运营端在浏览器直连本服务时）=====
# `*` 或逗号分隔的 Origin 白名单（生产建议收敛为具体域名；
# 生产取 `*` 时启动会打告警 —— 任意站点均可跨域调用本服务）
CORS_ALLOW_ORIGINS=*

# ===== 腾讯云 COS（档口海报 / 菜品图转存）=====
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
# 图片访问域名（如 https://xxx-1408890131.cos.ap-shanghai.myqcloud.com）
# 🔴 所有环境必填：图片出参恒绝对 URL，缺失时服务拒绝启动（见 app/core/config.py）
COS_DOMAIN=

# 说明：真值只写 server/.env.development 与 server/.env.production（均已 gitignore）；
# 本文件仅列占位符，勿填真实凭据。
