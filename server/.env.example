# 食在交大 后端环境变量占位（复制本文件为 server/.env 并填入真实值，.env 已被 .gitignore 忽略，不会入库）
# 所有项均为示例占位，请勿在此文件写入真实凭据后提交。

# ---------- JWT 签名密钥 ----------
# 生产/云端必须注入强随机密钥（建议 >=32 字节），例如：openssl rand -base64 48
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-bytes

# ---------- 数据库 ----------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/bjtu_food?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# ---------- SMTP 发件邮箱（网易 163） ----------
# 授权码在网易邮箱网页版「设置→POP3/SMTP/IMAP」开启后生成，非登录密码
SPRING_MAIL_USERNAME=your-email@163.com
SPRING_MAIL_PASSWORD=your-smtp-auth-code

# ---------- 上传文件访问基址 ----------
APP_PUBLIC_BASE_URL=http://localhost:8080/api
UPLOAD_PATH=./uploads/images
UPLOAD_URL_PREFIX=/images

# ---------- CORS 允许的前端源（逗号分隔，仅填受信任的小程序/后台域名） ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-admin-domain.com
