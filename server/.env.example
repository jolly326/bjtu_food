# ===== 数据库 =====
# SQLAlchemy 连接串（MySQL 5.7 + PyMySQL）
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@YOUR_HOST:27926/bjtu_food?charset=utf8mb4
DATABASE_USER=root
DATABASE_PASSWORD=YOUR_PASSWORD

# 兼容旧变量名：pydantic-settings 同时接受二者，填任一套即可（server/.env 里两套都有）
# SPRING_DATASOURCE_URL=YOUR_HOST:27926
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=YOUR_PASSWORD

# ===== JWT =====
# 学生端签名密钥（>= 32 字节随机串）
JWT_SECRET=replace-with-a-long-random-string
# 运营端签名密钥 —— 🔴 必须与学生端不同，否则学生 token 可冒充运营端
ADMIN_JWT_SECRET=replace-with-another-long-random-string

# ===== 微信小程序 =====
WECHAT_APPID=
WECHAT_SECRET=

# ===== 跨域（运营端在浏览器直连本服务时）=====
# `*` 或逗号分隔的 Origin 白名单（生产建议收敛为具体域名）
CORS_ALLOW_ORIGINS=*

# ===== 腾讯云 COS（档口海报 / 菜品图转存）=====
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
# 图片访问域名（如 https://xxx-1408890131.cos.ap-shanghai.myqcloud.com）
# 🔴 云端必须配：缺省时图片出参退回相对路径，端上加载不出
COS_DOMAIN=

# 说明：真值只写 server/.env（已 gitignore）；本文件仅列占位符，勿填真实凭据。
