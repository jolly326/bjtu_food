# 食在交大 后端环境变量占位（复制本文件为 server/.env 并填入真实值，.env 已被 .gitignore 忽略，不会入库）
# 所有项均为示例占位，请勿在此文件写入真实凭据后提交。

# ---------- 管理端（Web 后台）口令 ----------
# 2026-09-13 定型：后台无登录体系，/admin/** 由 AdminTokenFilter 校验请求头 X-Admin-Token。
# 未配置 → fail-closed：全部管理端请求返回 403。云端/生产必须注入（与 web/.env.local 的 VITE_ADMIN_TOKEN 一致）。
ADMIN_TOKEN=your-admin-token

# ---------- JWT 签名密钥 ----------
# 生产/云端必须注入强随机密钥（建议 >=32 字节），例如：openssl rand -base64 48
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-bytes

# ---------- 数据库 ----------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/bjtu_food?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# ---------- SMTP 发件邮箱（网易 163） ----------
# 授权码在网易邮箱网页版「设置→POP3/SMTP/IMAP」开启后生成，非登录密码
SPRING_MAIL_USERNAME=your-email@163.com
SPRING_MAIL_PASSWORD=your-smtp-auth-code

# ---------- 上传文件访问基址 ----------
APP_PUBLIC_BASE_URL=http://localhost:8080/api
UPLOAD_PATH=./uploads/images
UPLOAD_URL_PREFIX=/images

# ---------- CORS 允许的前端源（逗号分隔，仅填受信任的小程序/后台域名） ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-admin-domain.com

# ---------- 微信小程序（code2Session，spec §5.y） ----------
# AppID / Secret 从小程序后台获取：微信公众平台→开发→开发管理→开发设置。
# Secret 仅首次生成时展示，请妥善保存；本地联调建议使用开发者工具测试号或正式小程序。
WECHAT_APPID=wx-your-appid
WECHAT_SECRET=your-app-secret

# ---------- 微信云开发（CloudBase）环境 ID（UGC 配图 batchdownloadfile 拉图用） ----------
# 缺省为空时后端尝试从 fileID 自动解析 env 段；仅当解析失败才要求显式配置
WECHAT_CLOUD_ENV=your-cloud-env-id

# ---------- 腾讯云 COS 对象存储（UGC 配图最终存储，2026-09-13 产品定稿） ----------
# 四项均必填才视为已配置；未配置时 POST /api/upload/images 返回 400「图片存储未配置」，
# 旧 multipart /api/upload/image 自动降级本地磁盘存储。
# 密钥在腾讯云控制台「访问管理→API 密钥管理」获取；bucket 形如 1250000000/bjtu-food（AppID/桶名）。
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-beijing
