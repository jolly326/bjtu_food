<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bjtufood.review.mapper.ReviewMapper">

    <!--
    ============================================================
    评价模块 - 自定义 SQL 映射

    基础 CRUD 由 MyBatis-Plus 自动生成。
    自定义查询（如：评价列表关联用户表）在此编写。

    命名规则：
    - selectReviewPageByDishId：公开列表（按菜品，联表补齐作者昵称/头像，时间倒序，可选只看有图）
    - selectReviewPageByUserId：我的评价（本人视角，含 dishId/dishName/isHidden）
    - selectAvgRatingByStallIds：批量统计多个档口平均分

    排序口径（2026-09-20 拍板）：评价列表排序唯一为 created_at DESC，
    原「按有用数置顶」第二口径与 sort 入参已随「有用」全链下线一并删除。

    可见性口径（2026-09-15 用户拍板「取消人工复核，sec_state 全链退役」）：
    - 公开列表唯一判据为 is_hidden=0；本人视角（我的评价）不过滤 is_hidden。
    - images_json 列为配图 URL 列表 JSON 原文（review.images），由 service 层解析为 images 数组，不在 SQL 层转换。
    ============================================================
    -->

    <select id="selectReviewPageByDishId" resultType="com.bjtufood.review.dto.ReviewVO">
        SELECT
            r.id,
            r.user_id,
            u.nickname AS user_nickname,
            u.avatar AS user_avatar,
            r.rating,
            r.content,
            r.images AS images_json,
            r.created_at
        FROM review r
                 JOIN user u ON r.user_id = u.id
        WHERE r.dish_id = #{dishId}
          AND r.is_hidden = 0
        <if test="hasImage != null and hasImage == 1">
            -- 只看有图：images 非空且不为空数组（空串/[] 视为无图）
            AND r.images IS NOT NULL AND r.images &lt;&gt; '' AND r.images &lt;&gt; '[]'
        </if>
        ORDER BY r.created_at DESC
    </select>

    <!--
        我的评价：本人视角，返回 images 供作者本人查看，并返回作者视角字段
        dish_id/dish_name/is_hidden（公开列表不返回这三者）。
        可见性（2026-09-14 §7.14 C）：本人视角不过滤 is_hidden，被管理员隐藏的评价作者仍可见。
        排序：固定时间倒序。dishId 可选过滤（详情页判定「我是否已评价」）。
    -->
    <select id="selectReviewPageByUserId" resultType="com.bjtufood.review.dto.ReviewVO">
        SELECT
            r.id,
            r.user_id,
            r.dish_id,
            d.name AS dish_name,
            u.nickname AS user_nickname,
            u.avatar AS user_avatar,
            r.rating,
            r.content,
            r.images AS images_json,
            r.is_hidden AS is_hidden,
            r.created_at
        FROM review r
                 JOIN user u ON r.user_id = u.id
                 JOIN dish d ON r.dish_id = d.id
        WHERE r.user_id = #{userId}
        <if test="dishId != null">
            AND r.dish_id = #{dishId}
        </if>
        ORDER BY r.created_at DESC
    </select>

    <!--
        批量：多个档口下所有菜品评价的平均分，一次查询返回 stall_id → avg(rating) 映射。
        计入口径（2026-09-15 归一）：仅 is_hidden=0 的评价计入（与 dish 评分聚合同口径）。
    -->
    <select id="selectAvgRatingByStallIds" resultType="com.bjtufood.review.dto.StallAvgRatingVO">
        SELECT d.stall_id     AS stallId,
               AVG(r.rating)  AS avgRating
        FROM review r
                 JOIN dish d ON r.dish_id = d.id
        WHERE d.stall_id IN
        <foreach collection="stallIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
          AND r.is_hidden = 0
        GROUP BY d.stall_id
    </select>

</mapper>
