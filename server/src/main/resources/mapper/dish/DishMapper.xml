<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bjtufood.dish.mapper.DishMapper">

    <!--
    ============================================================
    菜品模块 - 自定义 SQL 映射

    基础 CRUD 由 MyBatis-Plus 自动生成，无需在此编写。
    以下放置复杂查询（如多表关联、动态排序等）。

    命名规则：
    - select___：查询操作
    - count___：计数操作
    - update___：更新操作

    字段口径（2026-09-22 拍板：列表 / 详情出参拆分）：
    - 列表查询仅选 DishListItemVO 8 字段所需列（listDishColumns），详情查询选 DishDetailVO 15 字段所需列（detailDishColumns）；
    - 两者均不选 status/view_count/created_at/updated_at 等不出参列；
    - 管理端查询（adminDishColumns）额外选 status/stall_id/timestamps（管理端维护用）；
    - 坐标兜底 COALESCE 与 canteen 坐标列同批下线（位置表达收敛为 食堂 · 楼层 · 档口名）；
    - 标签 FIND_IN_SET(tag) 条件与 d.tags 模糊匹配随 tags 整链下线删除；
    - 辣度 spice_level 筛选条件随维度替换删除。
    ============================================================
    -->

    <!-- 列表行映射（DishListItemVO，8 字段；2026-09-22 列表 / 详情出参拆分 D 项）。
         仅声明下划线列名与属性名不同者，其余按 mapUnderscoreToCamelCase 自动映射 -->
    <resultMap id="dishListItemMap" type="com.bjtufood.dish.dto.DishListItemVO">
        <id property="id" column="id"/>
        <!-- 图片列 → List<String>（2026-09-23 R5，替换原 String imagesJson 中转字段）：
             仅供 Service 派生首图 coverImage，不出参（列表契约只有 coverImage 单值） -->
        <result property="imageUrls" column="images"
                typeHandler="com.bjtufood.common.persistence.StringListTypeHandler"/>
    </resultMap>

    <!-- 详情映射（DishDetailVO，11 字段） -->
    <resultMap id="dishDetailMap" type="com.bjtufood.dish.dto.DishDetailVO">
        <id property="id" column="id"/>
        <!-- 图片列 → List<String>（替换原 String imagesJson 中转字段）；
             绝对 URL 转换仍由 Service 层完成（TypeHandler 不掺业务逻辑） -->
        <result property="images" column="images"
                typeHandler="com.bjtufood.common.persistence.StringListTypeHandler"/>
        <result property="floor" column="floor"/>
        <!-- dish.attributes 的 JSON 原文：**内部字段**（VO 侧 @JsonIgnore），
             由 Service 结合字典整理为出参 attributes[]（机器值 + 中文标签） -->
        <result property="attributesJson" column="attributes"/>
    </resultMap>

    <!--
    🔴 **本文件不含热度排序表达式**：种子里 7 个视图全部走 random 排序（排序口径存 dish_filter_view.sort_kind），
    「热度排序」不是现存需求。
    浏览量（`dish_view_log` 30 天滚动窗口明细）**仅供管理端展示，不参与任何排序**——
    浏览量无上限，参与排序即可被低成本刷量霸榜。
    ⇒ 若后期引入热度排序，须重新拍板公式（**必须含浏览量封顶**，并同时处理去重，见 schema/dish_view_log.md §2.2）。
    如需稳定的翻页全序，各排序分支一律以 `d.id` 作决胜键。
    -->

    <!-- 联表 FROM 基础片段（dish + stall + canteen） -->
    <sql id="dishFromJoin">
        FROM dish d
                 JOIN stall s ON d.stall_id = s.id
                 JOIN canteen c ON s.canteen_id = c.id
    </sql>

    <!--
        列表查询列（DishListItemVO 8 字段所需列，2026-09-22 D 项拆分）：
        id/name/price/originalPrice/images(仅供 Service 解析首图 coverImage)/avgRating/stallName/canteenName。
        **列表不选**详情专属列（description/attributes/floor）；
        两场景均不选 status/view_count/created_at/updated_at/stall_id/canteen_id/window_no/坐标（列收窄）。
        WHERE/ORDER BY 中引用的 d.status/d.view_count 等为 FROM 子句列，无需出现在 SELECT 列表。
    -->
    <sql id="listDishColumns">
        d.id,
        d.name,
        d.price,
        d.original_price,
        d.images,
        <!-- 平均评分：**读缓存列** dish.avg_rating（零评价为 NULL → 出参 null），不做实时聚合 -->
        d.avg_rating,
        <!-- 字符串类字段空串兜底（2026-09-23 R12）：出参不出现 null，消费端无需兜底分支 -->
        COALESCE(s.name, '') AS stall_name,
        COALESCE(c.name, '') AS canteen_name
    </sql>

    <!-- 详情查询列（DishDetailVO 11 字段）= 列表列 + 详情专属列 -->
    <sql id="detailDishColumns">
        <include refid="listDishColumns"/>,
        <!-- 字符串类字段空串兜底：仅 originalPrice / avgRating 可为 null，其余描述类字段出空串 -->
        COALESCE(d.description, '') AS description,
        <!-- 描述属性 JSON 原文（不出参原文：Service 结合字典整理为 attributes[]） -->
        d.attributes,
        COALESCE(s.floor, '') AS floor
    </sql>

    <!-- 管理端查询列（DishAdminVO）：公开不出参的 status/stall_id/timestamps 管理端需要；不含坐标。 -->
    <sql id="adminDishColumns">
        d.id,
        d.stall_id,
        d.name,
        d.price,
        d.original_price,
        <!-- 字符串类字段空串兜底（2026-09-23 R12，与公开列表 / 详情同口径） -->
        COALESCE(d.description, '') AS description,
        d.images,
        d.status,
        d.avg_rating,
        d.rating_count,
        d.created_at,
        d.updated_at,
        d.attributes,
        d.meal_type_id,
        COALESCE(s.name, '') AS stall_name,
        COALESCE(c.name, '') AS canteen_name
    </sql>

    <!-- 分页查询菜品（列表专用 8 字段，2026-09-22 D 项拆分；仅 status='on'） -->
    <select id="selectDishPage" resultMap="dishListItemMap">
        SELECT
        <include refid="listDishColumns"/>
        <include refid="dishFromJoin"/>
        <!-- 档口/食堂已去实体化：无停业语义，原 s.status/c.status='open' 过滤已移除（列同批 DROP） -->
        <!-- 菜品审核语义已整体退役（2026-09-15 阶段4）：公开可见性唯一判据为上架状态 status='on' -->
        WHERE d.status = 'on'
        <if test="q.keyword != null and q.keyword != ''">
            -- 关键词三路模糊匹配：菜名 / 档口名 / 食堂名（2026-09-22 用户拍板：菜品无搜索别名，
            -- 原 d.alias LIKE 分支随 dish.alias 列全链删除；tags 模糊匹配已于 2026-09-20 随标签整链下线）
            -- ⚠️ 技术债（按代码审计登记，行为不动）：三处 `%keyword%` 前置通配 + 三表 OR ⇒ 任何索引都用不上，
            --    执行计划必为全表扫描（菜品表行数增长后是首要慢查询源）。彻底解决需改搜索形态
            --    （全文索引 / 独立检索服务）或产品侧收紧匹配范围，均属需拍板变更，故此处只登记不改。
            AND (d.name LIKE CONCAT('%', #{q.keyword}, '%')
            OR s.name LIKE CONCAT('%', #{q.keyword}, '%')
            OR c.name LIKE CONCAT('%', #{q.keyword}, '%'))
        </if>
        <!-- 视图筛选条件（A6：由 DishViewConditions 按**字段/操作符/值三层白名单**校验后下发；
             白名单非法值在 Service 层即 400、不落 SQL；全部取值走 #{} 预编译参数，**不拼接 SQL 文本**。
             组合关系只有 AND（一期不支持 OR）。字段清单见 docs/func/web/A-主数据维护/A6-首页筛选视图管理.md。
             与 DishViewConditions#toWrapper（计数 / 预览 / 抽样用）保持**同一套口径**。 -->
        <foreach collection="q.conditions" item="c">
            <choose>
                <when test="c.field == 'mealTypeId'">
                    <!-- mealTypeId 条件值 = 种类取值 ID（系统维度「菜品种类」下的取值行）；
                         直接匹配 dish.meal_type_id（走 idx_dish_meal_type），取值经 #{} 预编译参数绑定 -->
                    <choose>
                        <when test="c.op == 'in'">
                            AND d.meal_type_id IN
                            <foreach collection="c.values" item="v" open="(" separator="," close=")">#{v}</foreach>
                        </when>
                        <otherwise>AND d.meal_type_id = #{c.value}</otherwise>
                    </choose>
                </when>
                <when test="c.field == 'discount'">
                    AND d.original_price IS NOT NULL AND d.original_price &gt; d.price
                </when>
                <when test="c.field == 'price'">
                    <choose>
                        <when test="c.op == 'between'">AND d.price BETWEEN #{c.values[0]} AND #{c.values[1]}</when>
                        <when test="c.op == '&gt;='">AND d.price &gt;= #{c.value}</when>
                        <otherwise>AND d.price &lt;= #{c.value}</otherwise>
                    </choose>
                </when>
                <when test="c.field == 'stallId'">
                    <choose>
                        <when test="c.op == 'in'">
                            AND d.stall_id IN
                            <foreach collection="c.values" item="v" open="(" separator="," close=")">#{v}</foreach>
                        </when>
                        <otherwise>AND d.stall_id = #{c.value}</otherwise>
                    </choose>
                </when>
                <when test="c.field == 'canteenId'">
                    <!-- 复用联表内的 s.canteen_id（FROM 已 JOIN stall s），无需子查询 -->
                    <choose>
                        <when test="c.op == 'in'">
                            AND s.canteen_id IN
                            <foreach collection="c.values" item="v" open="(" separator="," close=")">#{v}</foreach>
                        </when>
                        <otherwise>AND s.canteen_id = #{c.value}</otherwise>
                    </choose>
                </when>
                <when test="c.field == 'avgRating'">
                    AND COALESCE(d.avg_rating, 0) &gt;= #{c.value}
                </when>
                <when test="c.field == 'createdAt'">
                    AND d.created_at &gt;= DATE_SUB(NOW(), INTERVAL #{c.value} DAY)
                </when>
            </choose>
        </foreach>
        <!-- 排序按视图的 sortKind 分派（端上无排序入口；食堂 / 价格筛选条件已随 2026-09-22 K3「筛选全量下线」删除）：
             ① SEED_RANDOM 且无 keyword（推荐视图 / 6 个大类视图，2026-10-05 起全部走此口径）→ CRC32(CONCAT(seed,'-',id)), id 稳定伪随机序
                —— 同一 seed ⇒ 同一全序（翻页不重不漏），换 seed ⇒ 整体重洗（每次进入看到不同组合）；
                d.id 作决胜键，消除 CRC32 哈希碰撞导致的并列乱序；
             ② DISCOUNT_DESC（折扣视图）→ 折扣力度倒序，d.id 作决胜键；
             ③ 其余（RATING_DESC / NEWEST）→ 各自主序 + d.id 决胜键。
             🔴 **无「热度排序」分支**（理由见上方注释块）。
             🔴 各分支一律带 `d.id` 决胜键 —— 保证全序稳定，否则同值行序不定会导致翻页重复/漏项。
             seed 走 #{} 预编译参数（防注入）；端上仍无排序入口（sortBy/sortOrder 已删） -->
        <choose>
            <when test="q.sortKind.name() == 'SEED_RANDOM'">
                ORDER BY CRC32(CONCAT(#{q.seed}, '-', d.id)), d.id
            </when>
            <!-- A6 的显式排序口径（白名单见 DishViewConditions.SORT_KINDS）：
                 种子里 7 个视图均未使用，保留供后台为视图配置时启用。
                 🔴 均以 d.id 作决胜键（不用热度）—— 保证同值行序稳定、翻页不重不漏 -->
            <when test="q.sortKind.name() == 'DISCOUNT_DESC'">
                ORDER BY (d.original_price - d.price) / d.original_price DESC, d.id DESC
            </when>
            <when test="q.sortKind.name() == 'PRICE_ASC'">
                ORDER BY d.price ASC, d.id DESC
            </when>
            <when test="q.sortKind.name() == 'PRICE_DESC'">
                ORDER BY d.price DESC, d.id DESC
            </when>
            <when test="q.sortKind.name() == 'RATING_DESC'">
                ORDER BY COALESCE(d.avg_rating, 0) DESC, d.rating_count DESC, d.id DESC
            </when>
            <when test="q.sortKind.name() == 'NEWEST'">
                ORDER BY d.created_at DESC, d.id DESC
            </when>
            <!-- 🔴 兜底分支：按 `d.id` 升序 —— 语义中性且全序稳定（本文件无热度排序，见文件头说明） -->
            <otherwise>
                ORDER BY d.id
            </otherwise>
        </choose>
    </select>

    <!-- 菜品详情（详情专用 11 字段） -->
    <select id="selectDishDetail" resultMap="dishDetailMap">
        SELECT
        <include refid="detailDishColumns"/>
        <include refid="dishFromJoin"/>
        <!-- 公开详情可见性判据同上：仅 status='on'（audit_status 列已退役） -->
        WHERE d.id = #{id}
          AND d.status = 'on'
        LIMIT 1
    </select>

    <!-- DishAdminVO 结果映射（后台全部菜品） -->
    <resultMap id="dishAdminVOMap" type="com.bjtufood.dish.dto.DishAdminVO">
        <id property="id" column="id"/>
        <!-- 图片列 → List<String>（2026-09-23 R5，替换原 String imagesJson 中转字段） -->
        <result property="images" column="images"
                typeHandler="com.bjtufood.common.persistence.StringListTypeHandler"/>
        <result property="stallId" column="stall_id"/>
        <result property="name" column="name"/>
        <result property="originalPrice" column="original_price"/>
        <result property="mealTypeId" column="meal_type_id"/>
    </resultMap>

    <!-- 管理端列表行（A3「列表 / 详情 VO 分离」，2026-10-03）：
         **不含** description / attributes / 全量 images —— 列表是扫视场景，不为 20 行的大字段买单。
         封面只取 images 首图（SQL 层 JSON_EXTRACT 第 0 项，不在 Java 侧解析整串），无图兜空串。 -->
    <sql id="adminDishListColumns">
        d.id,
        d.stall_id,
        d.name,
        d.price,
        d.original_price,
        COALESCE(JSON_UNQUOTE(JSON_EXTRACT(d.images, '$[0]')), '') AS cover_image,
        d.status,
        d.avg_rating,
        d.rating_count,
        d.updated_at,
        d.meal_type_id,
        COALESCE(s.name, '') AS stall_name,
        COALESCE(c.name, '') AS canteen_name
    </sql>

    <resultMap id="dishAdminListItemMap" type="com.bjtufood.dish.dto.DishAdminListItemVO">
        <id property="id" column="id"/>
        <!-- 仅声明下划线列名与属性名不同者，其余按 mapUnderscoreToCamelCase 自动映射 -->
        <result property="originalPrice" column="original_price"/>
        <result property="coverImage" column="cover_image"/>
        <result property="mealTypeId" column="meal_type_id"/>
        <result property="stallName" column="stall_name"/>
        <result property="canteenName" column="canteen_name"/>
    </resultMap>

    <!-- 管理端列表筛选条件（A3）：stallId / canteenId（经档口间接）/ mealTypeId / status / keyword。
         keyword 与公开列表**同口径**（菜名 / 档口名 / 食堂名三路模糊）—— 该形态无法走索引，
         属已知取舍（与 client 搜索同源，见本文件顶部「技术债」登记）。 -->
    <sql id="adminDishWhere">
        <where>
            <if test="q.stallId != null">
                AND d.stall_id = #{q.stallId}
            </if>
            <if test="q.canteenId != null">
                AND s.canteen_id = #{q.canteenId}
            </if>
            <if test="q.mealTypeId != null">
                AND d.meal_type_id = #{q.mealTypeId}
            </if>
            <if test="q.status != null and q.status != ''">
                AND d.status = #{q.status}
            </if>
            <if test="q.keyword != null and q.keyword != ''">
                AND (d.name LIKE CONCAT('%', #{q.keyword}, '%')
                OR s.name LIKE CONCAT('%', #{q.keyword}, '%')
                OR c.name LIKE CONCAT('%', #{q.keyword}, '%'))
            </if>
        </where>
    </sql>

    <!-- 后台全部菜品列表（含已下架，联表档口/食堂名称；**瘦身列表 VO**）。
         分页：避免菜品量增长后单次请求全表加载打满连接/内存。
         排序固定按 updated_at DESC（最近维护在前），端上无排序入口。 -->
    <select id="selectAdminListPage" resultMap="dishAdminListItemMap">
        SELECT
        <include refid="adminDishListColumns"/>
        <include refid="dishFromJoin"/>
        <include refid="adminDishWhere"/>
        ORDER BY d.updated_at DESC
    </select>

    <!--
        猜你喜欢：
        抽取在售菜品名——不看热度、不排序、不做个性化（搜索页迷茫时刻的试探入口）。
        刷新边界 = **重进小程序**（2026-09-29 收窄，推翻 2026-09-28「每次刷新」旧拍板）：
        端上无「主动换一批」入口（全仓无下拉刷新），会话内内容自变 ⇒ 用户只会读成「界面不稳定」；
        故端上传**会话级 seed**，本查询按 CRC32(CONCAT(seed,'-',d.id)), d.id 做稳定伪随机序
          · 同一次会话内多次进入 ⇒ 同一批词条（内容不会自己变）；
          · 重进小程序 ⇒ seed 重掷 ⇒ 整体重洗（新鲜度）。
        算法与推荐流（selectDishPage 的 SEED_RANDOM 分支）同一套：d.id 作决胜键消除 CRC32 并列乱序。
        seed 由 Service 侧保证非空：{@code DishServiceImpl#guessLike} 在未传 seed 时补一个一次性随机值，
        故这里不再保留 ORDER BY RAND() 兜底（那是全表排序：代价随行数增长且无法使用索引）。
        契约未变：未传 seed 的调用方仍得到「每次不同的随机序」，只是随机性改由 seed 承载。
        出参仅 name；条数由调用方传入（DishMapper#selectGuessLike(@Param limit, @Param seed)，Service 侧常量）。
        注意：本查询**不走**任何热度/排序表达式（热度算法已于 2026-10-05 全量下线；此处为纯随机抽取）。
    -->
    <select id="selectGuessLike" resultType="com.bjtufood.dish.dto.GuessLikeVO">
        SELECT d.name AS name
        FROM dish d
        WHERE d.status = 'on'
        ORDER BY CRC32(CONCAT(#{seed}, '-', d.id)), d.id
        LIMIT #{limit}
    </select>

    <!--
        评分对账的候选菜品（D3）：只取「缓存列 rating_count > 0」的行。
        零评价菜品按口径本就恒为 avg_rating=NULL / rating_count=0，无需参与对账，
        该条件把扫描面收敛到「真正发生过评分事件」的菜品，避免全表扫描。
        游标分页（id > lastId ORDER BY id LIMIT n）而非 OFFSET：对账期间菜品可能增删，
        OFFSET 会因行位移漏行/重复行，游标法不受影响。
    -->
    <select id="selectDishIdsWithRatings" resultType="long">
        SELECT d.id
        FROM dish d
        WHERE d.rating_count > 0
          AND d.id > #{lastId}
        ORDER BY d.id
        LIMIT #{limit}
    </select>

    <!--
        评分聚合原子重算（并发安全：子查询 AVG/COUNT 整体写回）。
        计入口径（Q-110 / 2026-09-15 归一）：仅 is_hidden=0 的评价计入 avg_rating / rating_count——
        sec_state 已随「取消人工复核」全链退役，故过滤条件收敛为 is_hidden=0 单一判据。
        avg_rating 在<b>零评价时为 NULL</b>（不落 0）：公开出参以 avg_rating 是否 NULL 判「有无评分」，
        落 0 会让「零评价」与「均分 0」这两种不同事实坍缩为同一个值。
        ReviewMapper 的档口均值查询与本口径同源。
    -->
    <update id="recalcRatingBySubquery">
        UPDATE dish d
        SET d.avg_rating = (SELECT ROUND(AVG(r.rating), 1)
                            FROM review r
                            WHERE r.dish_id = d.id
                              AND r.is_hidden = 0),
            d.rating_count = (SELECT COUNT(*)
                              FROM review r
                              WHERE r.dish_id = d.id
                                AND r.is_hidden = 0)
        WHERE d.id = #{dishId}
    </update>

    <!--
        批量：多个档口下的菜品数（管理端档口列表 GET /admin/stalls 的 dishCount）。
        一次 COUNT(*) GROUP BY stall_id 取回「档口 → 菜品数」映射，替代逐档口查询的 N+1。
        口径与逐档口计数（DishService#countByStallId 走 selectCount）一致：只按 stall_id 过滤，
        **不筛在售状态** —— 该计数回答的是「档口下还有没有菜」，下架菜同样不能随档口一起消失。
        🔴 映射到 POJO（DishMapper$StallDishCountRow）而非 java.util.Map：项目开了
        map-underscore-to-camel-case，resultType=Map 的键名映射行为不确定（实测取不到值）；
        @MapKey + resultMap 的值又是整行 HashMap，泛型声明 Map<Long,Long> 会 ClassCastException。
        🔴 IN 列表由调用方传入且非空；无菜品的档口不出现在结果中，由调用方补 0。
    -->
    <select id="countByStallIds" resultType="com.bjtufood.dish.mapper.DishMapper$StallDishCountRow">
        SELECT stall_id AS stallId, COUNT(*) AS dishCount
        FROM dish
        WHERE stall_id IN
        <foreach collection="stallIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
        GROUP BY stall_id
    </select>

</mapper>
