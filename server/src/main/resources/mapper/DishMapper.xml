<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bjtufood.dish.mapper.DishMapper">

    <!--
    ============================================================
    菜品模块 - 自定义 SQL 映射

    基础 CRUD 由 MyBatis-Plus 自动生成，无需在此编写。
    以下放置复杂查询（如多表关联、动态排序等）。

    命名规则：
    - select___：查询操作
    - count___：计数操作
    - update___：更新操作

    字段口径（2026-09-20 拍板）：
    - 公开查询仅选 DishVO 15 字段所需列（status/view_count/created_at/updated_at/alias 等不出参也不查询）；
    - 管理端查询（adminDishColumns）额外选 status/stall_id/alias/timestamps（管理端维护用）；
    - 坐标兜底 COALESCE 与 canteen 坐标列同批下线（位置表达收敛为 食堂 · 楼层 · 档口名）；
    - 标签 FIND_IN_SET(tag) 条件与 d.tags 模糊匹配随 tags 整链下线删除；
    - 辣度 spice_level 筛选条件随维度替换删除（§7.28）。
    ============================================================
    -->

    <!-- DishVO / DishDetailVO 结果映射（仅声明下划线列名与属性名不同者；其余按 mapUnderscoreToCamelCase 自动映射） -->
    <resultMap id="dishVOMap" type="com.bjtufood.dish.dto.DishVO">
        <id property="id" column="id"/>
        <result property="floor" column="floor"/>
        <result property="dietType" column="diet_type"/>
        <result property="ingredients" column="ingredients"/>
        <result property="flavorTags" column="flavor_tags"/>
        <result property="serveTemp" column="serve_temp"/>
    </resultMap>

    <resultMap id="dishDetailMap" type="com.bjtufood.dish.dto.DishDetailVO"
               extends="dishVOMap"/>

    <!--
    综合热度分表达式（**热度权重的唯一真源**）：
        view_count*1 + rating_count*5*20 + COALESCE(avg_rating,0)*20
        权重：浏览量 1、评价数 5*20=100、评分 20。
    注意（Q-109，2026-09-14 用户拍板）：Java 侧 DishHeatWeights 常量已删除，热度口径**只存在于本处 SQL**。
    如需调整权重，**直接改本片段**（并按需同步 docs/project_spec.md 相关性条款），不存在第二处需同步的常量，
    避免「改了常量以为生效」的误判。
    仅供「等价口径」复用（heat 排序、热搜词条）；其他独立业务口径请勿 include 本片段。
    -->
    <sql id="heatScoreExpr">
        (d.view_count * 1 + d.rating_count * 5 * 20 + COALESCE(d.avg_rating, 0) * 20)
    </sql>

    <!-- 联表 FROM 基础片段（dish + stall + canteen） -->
    <sql id="dishFromJoin">
        FROM dish d
                 JOIN stall s ON d.stall_id = s.id
                 JOIN canteen c ON s.canteen_id = c.id
    </sql>

    <!--
        公开查询列（DishVO 15 字段）：id/name/price/originalPrice/description/images/
        stallName/canteenName/floor/avgRating/ratingCount/dietType/ingredients/flavorTags/serveTemp。
        公开出参不含 status/view_count/created_at/updated_at/alias/stall_id/canteen_id/window_no/坐标，
        故此处不选这些列（列收窄）。WHERE/ORDER BY 中引用的 d.status/d.created_at 等为 FROM 子句列，无需出现在 SELECT 列表。
    -->
    <sql id="publicDishColumns">
        d.id,
        d.name,
        d.price,
        d.original_price,
        d.description,
        d.images  AS images_json,
        d.avg_rating,
        d.rating_count,
        d.diet_type,
        d.ingredients,
        d.flavor_tags,
        d.serve_temp,
        s.name AS stall_name,
        s.floor,
        c.name AS canteen_name
    </sql>

    <!-- 管理端查询列（DishAdminVO）：公开不出参的 status/stall_id/alias/timestamps 管理端需要；不含坐标。 -->
    <sql id="adminDishColumns">
        d.id,
        d.stall_id,
        d.name,
        d.alias,
        d.price,
        d.original_price,
        d.description,
        d.images  AS images_json,
        d.status,
        d.avg_rating,
        d.rating_count,
        d.created_at,
        d.updated_at,
        d.diet_type,
        d.meal_type,
        d.ingredients,
        d.flavor_tags,
        d.serve_temp,
        s.name AS stall_name,
        c.name AS canteen_name
    </sql>

    <!-- 分页查询菜品 -->
    <select id="selectDishPage" resultMap="dishVOMap">
        SELECT
        <include refid="publicDishColumns"/>
        <include refid="dishFromJoin"/>
        <!-- 档口/食堂已去实体化（§7.14）：无停业语义，原 s.status/c.status='open' 过滤已移除（列同批 DROP） -->
        <!-- 菜品审核语义已整体退役（2026-09-15 阶段4）：公开可见性唯一判据为上架状态 status='on' -->
        WHERE d.status = 'on'
        <if test="req.keyword != null and req.keyword != ''">
            -- 菜品名或别名命中即返回（alias 为管理员配置的逗号分隔别名，NULL 行 LIKE 恒 false 不影响 OR 短路）；
            -- tags 模糊匹配已随标签整链下线删除（2026-09-20）
            AND ((d.name LIKE CONCAT('%', #{req.keyword}, '%')
            OR d.alias LIKE CONCAT('%', #{req.keyword}, '%'))
            OR s.name LIKE CONCAT('%', #{req.keyword}, '%')
            OR c.name LIKE CONCAT('%', #{req.keyword}, '%'))
        </if>
        <if test="req.canteenId != null">
            AND c.id = #{req.canteenId}
        </if>
        <!-- 菜品大类筛选（2026-09-21 §7.34）：单值精确匹配；白名单校验在 Service 层（非法值 400，不落 SQL） -->
        <if test="req.mealType != null and req.mealType != ''">
            AND d.meal_type = #{req.mealType}
        </if>
        <if test="req.minPrice != null">
            AND d.price &gt;= #{req.minPrice}
        </if>
        <if test="req.maxPrice != null">
            AND d.price &lt;= #{req.maxPrice}
        </if>
        <!-- 排序口径收敛（2026-09-21 §7.33）：删除 sortBy/sortOrder 的 <choose> 分支（原 <otherwise> =
             ORDER BY d.rating_count DESC, d.avg_rating DESC 一并移除），默认流 / 筛选流 / 搜索流
             三路统一为唯一热度口径 -->
        ORDER BY <include refid="heatScoreExpr"/> DESC
    </select>

    <!-- 菜品详情 -->
    <select id="selectDishDetail" resultMap="dishDetailMap">
        SELECT
        <include refid="publicDishColumns"/>
        <include refid="dishFromJoin"/>
        <!-- 公开详情可见性判据同上：仅 status='on'（audit_status 列已退役） -->
        WHERE d.id = #{id}
          AND d.status = 'on'
        LIMIT 1
    </select>

    <!-- DishAdminVO 结果映射（后台全部菜品） -->
    <resultMap id="dishAdminVOMap" type="com.bjtufood.dish.dto.DishAdminVO">
        <id property="id" column="id"/>
        <result property="stallId" column="stall_id"/>
        <result property="name" column="name"/>
        <result property="alias" column="alias"/>
        <result property="originalPrice" column="original_price"/>
        <result property="dietType" column="diet_type"/>
        <result property="ingredients" column="ingredients"/>
        <result property="flavorTags" column="flavor_tags"/>
        <result property="serveTemp" column="serve_temp"/>
        <result property="mealType" column="meal_type"/>
    </resultMap>

    <!-- 后台全部菜品列表（含已下架，联表档口/食堂名称）。
         分页：避免菜品量增长后单次请求全表加载打满连接/内存。
         排序固定按 updated_at DESC，与管理端预期一致。 -->
    <select id="selectAllForAdmin" resultMap="dishAdminVOMap">
        SELECT
        <include refid="adminDishColumns"/>
        <include refid="dishFromJoin"/>
        ORDER BY d.updated_at DESC
    </select>

    <!--
        评分分布。
        计入口径（Q-110 / 2026-09-15 归一）：仅 is_hidden=0 的评价计入——
        sec_state 已随「取消人工复核」全链退役（内容安全检测 pass/review 一律放行、risky 直接拒绝不入库），
        故不再存在安全态过滤条件（与 recalcRatingBySubquery 同口径）。
    -->
    <select id="selectRatingDistribution" resultType="com.bjtufood.dish.dto.RatingDistributionVO">
        SELECT rating AS star, COUNT(*) AS count
        FROM review
        WHERE dish_id = #{dishId}
          AND is_hidden = 0
        GROUP BY rating
    </select>

    <!-- 热搜词条 TOP10（基于菜品综合热度派生的热门词条，无真实搜索词埋点） -->
    <select id="selectHotSearch" resultType="com.bjtufood.dish.dto.HotSearchVO">
        SELECT d.name AS keyword,
               CAST(<include refid="heatScoreExpr"/> AS SIGNED) AS heat
        FROM dish d
        WHERE d.status = 'on'
        ORDER BY heat DESC
        LIMIT 10
    </select>

    <!-- 菜品大类字典下发（2026-09-21 §7.34）：只回答「哪些大类当前有在售菜品」（空类自动隐藏）；
         标签文案与顺序由 MealTypeConst 唯一定义，本查询不涉及（单一真源不漂移） -->
    <select id="selectInStockMealTypes" resultType="string">
        SELECT DISTINCT d.meal_type
        FROM dish d
        WHERE d.status = 'on'
          AND d.meal_type IS NOT NULL
    </select>

    <!-- 浏览量原子自增（并发安全：读-改-写 → SET view_count = view_count + 1） -->
    <update id="increaseViewCount">
        UPDATE dish
        SET view_count = view_count + 1
        WHERE id = #{id}
    </update>

    <!--
        评分聚合原子重算（并发安全：子查询 AVG/COUNT 整体写回）。
        计入口径（Q-110 / 2026-09-15 归一）：仅 is_hidden=0 的评价计入 avg_rating / rating_count——
        sec_state 已随「取消人工复核」全链退役，故过滤条件收敛为 is_hidden=0 单一判据。
        全量重算与增量路径（selectRatingDistribution、ReviewMapper 的档口均值查询）保持同一口径，否则会再次漂移。
    -->
    <update id="recalcRatingBySubquery">
        UPDATE dish d
        SET d.avg_rating = IFNULL(
                (SELECT ROUND(AVG(r.rating), 1)
                 FROM review r
                 WHERE r.dish_id = d.id
                   AND r.is_hidden = 0),
                0),
            d.rating_count = (SELECT COUNT(*)
                              FROM review r
                              WHERE r.dish_id = d.id
                                AND r.is_hidden = 0)
        WHERE d.id = #{dishId}
    </update>

</mapper>
