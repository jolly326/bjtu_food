<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bjtufood.dish.mapper.DishMapper">

    <!--
    ============================================================
    菜品模块 - 自定义 SQL 映射

    基础 CRUD 由 MyBatis-Plus 自动生成，无需在此编写。
    以下放置复杂查询（如多表关联、动态排序等）。

    命名规则：
    - select___：查询操作
    - count___：计数操作
    - update___：更新操作
    ============================================================
    -->

    <!-- DishVO / DishDetailVO 结果映射 -->
    <resultMap id="dishVOMap" type="com.bjtufood.dish.dto.DishVO">
        <id property="id" column="id"/>
        <result property="stallId" column="stall_id"/>
        <result property="categoryId" column="category_id"/>
        <result property="canteenId" column="canteen_id"/>
        <!-- 档口位置链路字段（来自 stall 联表）：楼层/窗口号（营业时间已于 2026-09-14 §7.14 D 下线） -->
        <result property="floor" column="floor"/>
        <result property="windowNo" column="window_no"/>
        <!-- 食堂坐标（GCJ-02）：前端本地算距离用，服务器不再计算 distance -->
        <result property="latitude" column="c_lat"/>
        <result property="longitude" column="c_lng"/>
        <!-- 菜品属性标签字段 -->
        <result property="spiceLevel" column="spice_level"/>
        <result property="portion" column="portion"/>
        <result property="region" column="region"/>
        <!-- 距用户距离（米）：无查询返回该列（selectHotDishesByDistance 已随 §7.10 下线），恒为 null -->
        <result property="distance" column="distance"/>
    </resultMap>

    <resultMap id="dishDetailMap" type="com.bjtufood.dish.dto.DishDetailVO"
               extends="dishVOMap"/>

    <!--
    综合热度分表达式（唯一 SQL 真源）：
        view_count*1 + rating_count*5*20 + COALESCE(avg_rating,0)*20
        权重：浏览量 1、评价数 5*20=100、评分 20。
    须与 Java 侧 DishHeatWeights（WEIGHT_VIEW / WEIGHT_RATING_COUNT / RATING_SCALE）保持等价，
    任一处调整权重需同步修改两侧，避免排序/热搜口径分叉。
    仅供「等价口径」复用（heat 排序、热搜词条）；其他独立业务口径请勿 include 本片段。
    -->
    <sql id="heatScoreExpr">
        (d.view_count * 1 + d.rating_count * 5 * 20 + COALESCE(d.avg_rating, 0) * 20)
    </sql>

    <!-- 联表查询基础 SQL 片段 -->
    <sql id="joinDishSql">
        SELECT
            d.id,
            d.name,
            d.alias,
            d.price,
            d.original_price,
            d.promo_price,
            d.images  AS images_json,
            d.tags,
            d.description,
            d.avg_rating,
            d.rating_count,
            d.view_count,
            d.status,
            d.created_at,
            d.updated_at,
            d.spice_level,
            d.portion,
            d.region,
            d.category_id,
            s.id   AS stall_id,
            s.name AS stall_name,
            s.floor,
            s.window_no,
            c.id   AS canteen_id,
            c.name AS canteen_name,
            -- 坐标缺失兜底（旧库 canteen 未填坐标）：回退校区中心默认值，保证前端「距你 Xm」恒有值
            COALESCE(c.latitude,  39.953800) AS c_lat,
            COALESCE(c.longitude, 116.335400) AS c_lng
        FROM dish d
                 JOIN stall s ON d.stall_id = s.id
                 JOIN canteen c ON s.canteen_id = c.id
    </sql>

    <!-- 分页查询菜品 -->
    <select id="selectDishPage" resultMap="dishVOMap">
        <include refid="joinDishSql"/>
        WHERE d.status = 'on'
          AND s.status = 'open'
          AND c.status = 'open'
          AND (d.audit_status = 'approved' OR d.audit_status IS NULL)
        <if test="req.keyword != null and req.keyword != ''">
            -- 菜品名或别名命中即返回（alias 为管理员配置的逗号分隔别名，NULL 行 LIKE 恒 false 不影响 OR 短路）
            AND ((d.name LIKE CONCAT('%', #{req.keyword}, '%')
            OR d.alias LIKE CONCAT('%', #{req.keyword}, '%'))
            OR s.name LIKE CONCAT('%', #{req.keyword}, '%')
            OR c.name LIKE CONCAT('%', #{req.keyword}, '%')
            OR d.tags LIKE CONCAT('%', #{req.keyword}, '%'))
        </if>
        <if test="req.canteenId != null">
            AND c.id = #{req.canteenId}
        </if>
        <if test="req.stallId != null">
            AND s.id = #{req.stallId}
        </if>
        <if test="req.categoryId != null">
            AND d.category_id = #{req.categoryId}
        </if>
        <if test="req.tag != null and req.tag != ''">
            -- 标签按精确成员匹配（tags 为逗号分隔 CSV），避免 LIKE 子串误匹配（如 signature 误配 signature_xxx）
            AND FIND_IN_SET(#{req.tag}, d.tags) > 0
        </if>
        <if test="req.spiceLevel != null">
            AND d.spice_level = #{req.spiceLevel}
        </if>
        <if test="req.minPrice != null">
            AND d.price &gt;= #{req.minPrice}
        </if>
        <if test="req.maxPrice != null">
            AND d.price &lt;= #{req.maxPrice}
        </if>
        <if test="req.excludeIds != null and req.excludeIds.size() > 0">
            AND d.id NOT IN
            <foreach collection="req.excludeIds" item="id" open="(" separator="," close=")">#{id}</foreach>
        </if>
        <choose>
            <when test="req.sortBy == 'heat'">
                ORDER BY <include refid="heatScoreExpr"/> DESC
            </when>
            <when test="req.sortBy == 'rating'">
                ORDER BY d.avg_rating
                <choose>
                    <when test="req.sortOrder == 'asc'">ASC</when>
                    <otherwise>DESC</otherwise>
                </choose>
            </when>
            <when test="req.sortBy == 'price'">
                ORDER BY d.price
                <choose>
                    <when test="req.sortOrder == 'desc'">DESC</when>
                    <otherwise>ASC</otherwise>
                </choose>
            </when>
            <!-- collects（收藏）排序已随收藏模块移除（BCNF 清理：favorite_count 删除），改用 rating_count 作为热度次级键 -->
            <when test="req.sortBy == 'created_at'">
                ORDER BY d.created_at
                <choose>
                    <when test="req.sortOrder == 'asc'">ASC</when>
                    <otherwise>DESC</otherwise>
                </choose>
            </when>
            <otherwise>
                ORDER BY d.rating_count DESC, d.avg_rating DESC
            </otherwise>
        </choose>
    </select>

    <!-- 菜品详情 -->
    <select id="selectDishDetail" resultMap="dishDetailMap">
        <include refid="joinDishSql"/>
        WHERE d.id = #{id}
          AND d.status = 'on'
          AND s.status = 'open'
          AND c.status = 'open'
          AND (d.audit_status = 'approved' OR d.audit_status IS NULL)
        LIMIT 1
    </select>

    <!-- 批量菜品详情（消除推荐/分页逐条详情的 N+1） -->
    <select id="selectDishDetailsByIds" resultMap="dishDetailMap">
        <include refid="joinDishSql"/>
        WHERE d.status = 'on'
          AND s.status = 'open'
          AND c.status = 'open'
          AND (d.audit_status = 'approved' OR d.audit_status IS NULL)
          AND d.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- DishAdminVO 结果映射（后台全部菜品） -->
    <resultMap id="dishAdminVOMap" type="com.bjtufood.dish.dto.DishAdminVO">
        <id property="id" column="id"/>
        <result property="stallId" column="stall_id"/>
        <result property="categoryId" column="category_id"/>
        <result property="name" column="name"/>
        <result property="alias" column="alias"/>
        <result property="originalPrice" column="original_price"/>
        <result property="promoPrice" column="promo_price"/>
        <result property="spiceLevel" column="spice_level"/>
        <result property="portion" column="portion"/>
        <result property="region" column="region"/>
    </resultMap>

    <!-- 后台全部菜品列表（含已下架，联表档口/食堂名称）。
         分页：避免菜品量增长后单次请求全表加载打满连接/内存。
         排序固定按 updated_at DESC，与管理端预期一致。 -->
    <select id="selectAllForAdmin" resultMap="dishAdminVOMap">
        <include refid="joinDishSql"/>
        ORDER BY d.updated_at DESC
    </select>

    <!-- 评分分布 -->
    <select id="selectRatingDistribution" resultType="com.bjtufood.dish.dto.RatingDistributionVO">
        SELECT rating AS star, COUNT(*) AS count
        FROM review
        WHERE dish_id = #{dishId}
          AND is_hidden = 0
        GROUP BY rating
    </select>

    <!-- 热搜词条 TOP10（基于菜品综合热度派生的热门词条，无真实搜索词埋点） -->
    <select id="selectHotSearch" resultType="com.bjtufood.dish.dto.HotSearchVO">
        SELECT d.name AS keyword,
               CAST(<include refid="heatScoreExpr"/> AS SIGNED) AS heat
        FROM dish d
        WHERE d.status = 'on'
          AND (d.audit_status = 'approved' OR d.audit_status IS NULL)
        ORDER BY heat DESC
        LIMIT 10
    </select>

    <!-- 浏览量原子自增（并发安全：读-改-写 → SET view_count = view_count + 1） -->
    <update id="increaseViewCount">
        UPDATE dish
        SET view_count = view_count + 1
        WHERE id = #{id}
    </update>

    <!-- 评分聚合原子重算（并发安全：子查询 AVG/COUNT 整体写回，仅统计未隐藏评价） -->
    <update id="recalcRatingBySubquery">
        UPDATE dish d
        SET d.avg_rating = IFNULL(
                (SELECT ROUND(AVG(r.rating), 1)
                 FROM review r
                 WHERE r.dish_id = d.id
                   AND r.is_hidden = 0),
                0),
            d.rating_count = (SELECT COUNT(*)
                              FROM review r
                              WHERE r.dish_id = d.id
                                AND r.is_hidden = 0)
        WHERE d.id = #{dishId}
    </update>

</mapper>
