/* 非颜色 token（圆角 / 间距 / 字号 / 字重 / 动效 / 层级 / 高度 / 结构尺寸）。
   口径见 docs/ui/client/设计变量.md；改值只改这里，再同步文档。 */

page {
  /* ===== 圆角 ===== */
  --radius-xs: 8rpx;
  --radius-btn: 32rpx;
  --radius-card: 40rpx;
  --radius-modal: 48rpx;
  --radius-pill: 999rpx;
  --radius-circle: 50%;

  /* ===== 间距（4pt 栅格）===== */
  --spacing-3xs: 2rpx;
  --spacing-2xs: 4rpx;
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  --spacing-2xl: 64rpx;
  --page-gutter: 32rpx;

  /* ===== 字体族 ===== */
  /* 衬线：菜名等"柔和优雅"标题用；正文 / 按钮仍用系统无衬线。
     🔴 小程序不引入自定义字体文件（体积与加载成本），只用系统衬线族。 */
  --font-serif: serif;

  /* ===== 字号 ===== */
  --font-display: 56rpx;
  --font-tiny: 20rpx;
  --font-small: 24rpx;
  --font-body: 28rpx;
  --font-subtitle: 32rpx;
  --font-h3: 36rpx;
  --font-h2: 40rpx;
  --font-title: 44rpx;

  /* ===== 字重 ===== */
  --weight-regular: 400;
  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;
  --weight-heavy: 800;

  /* ===== 动效 ===== */
  --duration-fast: 120ms;
  --duration-base: 200ms;
  --duration-slow: 300ms;
  --ease-out: cubic-bezier(0.22, 0.61, 0.36, 1);

  /* ===== 层级 ===== */
  --z-tabbar: 100;
  --z-sheet: 2000;
  --z-actionsheet: 4000;

  /* ===== 高度 ===== */
  --tabbar-height: 128rpx;
  --tabbar-gap: 24rpx;
  --tap-target-size: 88rpx;
  --reaction-item-min-width: 120rpx;

  /* ===== 本设计新增（结构尺寸）===== */
  --dish-punch-size: 16rpx;
  --poster-peek: 48rpx;
  --dish-photo-size: 440rpx;
  --record-photo-size: 240rpx;
  --record-card-width: 420rpx;
  --empty-action-size: 152rpx;
}

