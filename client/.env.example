# ============================================================
# 小程序端环境变量占位（复制本文件为 .env.development / .env.production 后改值）
#
# 🔴 两套传输通道，二选一（同时存在时**云调用优先**）：
#   A. 云调用 wx.cloud.callContainer —— 配 VITE_TCB_ENV，**真机免域名白名单**（推荐）
#   B. 直连域名 uni.request        —— 配 VITE_API_BASE_URL，真机须在
#      小程序后台「开发管理 → 服务器域名 → request 合法域名」加白名单
#
# 端点路径见 docs/api/（如 /posters、/auth/wechat-login）；后端在根路径提供服务。
# ============================================================

# ---- A. 云调用（推荐）----
# 取值：微信云托管控制台 → 环境概览 → 环境 ID（形如 prod-1gxxxxxx）
# VITE_TCB_ENV=prod-1gxxxxxx
# 服务名（云托管控制台创建服务时的名字）；留空 = 环境默认服务
# VITE_TCB_SERVICE=

# ---- B. 直连域名（回退）----
# 本地联调（后端 cd server && uvicorn app.main:app --host 0.0.0.0 --port 8000）
# VITE_API_BASE_URL=http://127.0.0.1:8000

# 真机预览（手机与电脑同一 WiFi，改成本机局域网 IP）
# VITE_API_BASE_URL=http://192.168.1.23:8000

# 微信云托管线上后端（云托管测试域名，仅供开发/真机调试）
# VITE_API_BASE_URL=https://bjtu-food-292909-9-1408890131.sh.run.tcloudbase.com
#
# 正式发布若走直连，必须换成【已 ICP 备案的 https 域名】并配置 request 合法域名。

# ---- 图片缩略图（可选）----
# true = 地图磁贴给图片追加 COS/CDN 处理参数 `imageMogr2/thumbnail/...`（需存储/CDN 支持）；
# false 或缺省 = 原图直出（任何环境都不会因处理参数不可用而失败）
# VITE_USE_COS_THUMB=false
