{
  "name": "uni-preset-vue",
  "version": "0.0.0",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:contract": "node scripts/check-contract.mjs",
    "check:ui": "node scripts/check-ui-tokens.mjs",
    "check:doc": "node scripts/check-doc-consistency.mjs",
    "lint": "eslint .",
    "verify": "npm run check:contract && npm run check:ui && npm run check:doc && npm run lint && npm run type-check && npm run test",
    "measure:perf": "node scripts/measure-perf.mjs",
    "probe:request": "node scripts/probe-request-layer.mjs",
    "gen:api": "openapi-typescript openapi.json -o src/types/generated/api.d.ts",
    "gen:api:fresh": "node scripts/fetch-openapi.mjs && npm run gen:api"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813001",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813001",
    "@eslint/js": "^9.39.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.1.3",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^15.11.7",
    "openapi-typescript": "^6.7.6",
    "sass": "^1.102.0",
    "typescript": "^4.9.4",
    "typescript-eslint": "^8.71.1",
    "vite": "5.2.8",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^1.0.24"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813001",
    "@dcloudio/uni-components": "3.0.0-5020420260813001",
    "@dcloudio/uni-h5": "3.0.0-5020420260813001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813001",
    "pinia": "2.1.7",
    "vue": "3.4.21"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "esbuild@0.20.2": true,
    "vue-demi@0.14.10": true
  }
}
